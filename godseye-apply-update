#!/usr/bin/env bash
set -euo pipefail
ZIP="${1:-}"; EXPECTED="${2:-}"
[[ "$ZIP" == /var/lib/godseye/updates/*.zip ]] || { echo "Refusing path outside GODSEYE update staging" >&2; exit 2; }
ACTUAL="$(sha256sum "$ZIP" | awk '{print $1}')"; [[ "$ACTUAL" == "$EXPECTED" ]] || { echo "SHA256 mismatch" >&2; exit 3; }
TMP="$(mktemp -d /tmp/godseye-update.XXXXXX)"; trap 'rm -rf "$TMP"' EXIT
unzip -q "$ZIP" -d "$TMP"
ROOT="$TMP"; [[ -f "$ROOT/app/main.py" ]] || ROOT="$(find "$TMP" -mindepth 1 -maxdepth 2 -type f -path '*/app/main.py' -printf '%h\n' | head -1 | xargs dirname)"
[[ -f "$ROOT/app/main.py" && -f "$ROOT/install.sh" && -f "$ROOT/VERSION" ]] || { echo "Invalid GODSEYE package" >&2; exit 4; }
/opt/godseye/.venv/bin/python -m py_compile "$ROOT"/app/*.py
bash -n "$ROOT/install.sh"
BACKUP="/var/lib/godseye/updates/pre-update-$(date -u +%Y%m%dT%H%M%SZ)"; mkdir -p "$BACKUP"; cp -a /opt/godseye/. "$BACKUP/"
rsync -a --delete --exclude '.venv' --exclude 'data' "$ROOT/" /opt/godseye/
/opt/godseye/.venv/bin/pip install -q -r /opt/godseye/requirements.txt
chown -R godseye:godseye /opt/godseye
systemctl restart godseye-web godseye-scanner
echo "Applied GODSEYE $(cat /opt/godseye/VERSION)"
