[Unit]
Description=GODSEYE Privileged Network Scanner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/godseye
Environment=GODSEYE_DB=/var/lib/godseye/godseye.db
Environment=GODSEYE_SCAN_INTERVAL=60
ExecStart=/opt/godseye/.venv/bin/python -m app.scanner
Restart=always
RestartSec=5
User=root
Group=godseye
UMask=0007
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/godseye

[Install]
WantedBy=multi-user.target
