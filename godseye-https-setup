#!/usr/bin/env bash
set -euo pipefail
HOST="${1:-}"; MODE="${2:-self-signed}"; [[ -n "$HOST" ]] || { echo "Usage: godseye-https-setup <hostname> [self-signed|letsencrypt]"; exit 2; }
mkdir -p /var/lib/godseye/tls; chmod 700 /var/lib/godseye/tls
if [[ "$MODE" == "self-signed" ]]; then
  openssl req -x509 -newkey rsa:3072 -sha256 -days 825 -nodes -keyout /var/lib/godseye/tls/godseye.key -out /var/lib/godseye/tls/godseye.crt -subj "/CN=$HOST" -addext "subjectAltName=DNS:$HOST"
else
  certbot certonly --nginx -d "$HOST"; cp "/etc/letsencrypt/live/$HOST/fullchain.pem" /var/lib/godseye/tls/godseye.crt; cp "/etc/letsencrypt/live/$HOST/privkey.pem" /var/lib/godseye/tls/godseye.key
fi
chmod 600 /var/lib/godseye/tls/godseye.key; chmod 644 /var/lib/godseye/tls/godseye.crt
cat >/etc/nginx/sites-available/godseye <<EOF
server { listen 80; server_name $HOST; return 301 https://\$host\$request_uri; }
server { listen 443 ssl http2; server_name $HOST; ssl_certificate /var/lib/godseye/tls/godseye.crt; ssl_certificate_key /var/lib/godseye/tls/godseye.key; location / { proxy_pass http://127.0.0.1:8080; proxy_set_header Host \$host; proxy_set_header X-Forwarded-Proto https; proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for; } }
EOF
ln -sf /etc/nginx/sites-available/godseye /etc/nginx/sites-enabled/godseye; nginx -t; systemctl enable --now nginx; systemctl reload nginx
echo "HTTPS configured for $HOST ($MODE)"
