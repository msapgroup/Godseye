#!/usr/bin/python3
"""Root helper: mount one selected, existing local backup filesystem safely."""
import os
import fcntl
import pwd
import re
import stat
import subprocess
import sys

TARGET='/var/lib/godseye-local-backup'
SUBDIR='.godseye-backups'

def cmd(*args):
    return subprocess.run(args,check=True,capture_output=True,text=True,timeout=15).stdout.strip()

def main(uuid):
    if not re.fullmatch(r'[A-Za-z0-9-]{1,128}',uuid):raise ValueError('Invalid filesystem UUID')
    matches=cmd('/usr/sbin/blkid','-t','UUID='+uuid,'-o','device').splitlines()
    if len(matches)!=1 or not matches[0].startswith('/dev/'):raise ValueError('Disk UUID must identify exactly one local device')
    device=os.path.realpath(matches[0])
    if not stat.S_ISBLK(os.stat(device).st_mode):raise ValueError('Selected device is not a block device')
    typ=cmd('/usr/bin/lsblk','-dnro','TYPE',device)
    ro=cmd('/usr/bin/lsblk','-dnro','RO',device)
    fs=cmd('/usr/sbin/blkid','-s','TYPE','-o','value',device).lower()
    if typ not in ('disk','part','crypt','lvm') or ro!='0' or fs not in ('ext2','ext3','ext4','xfs','btrfs','vfat','exfat','ntfs','ntfs3'):
        raise ValueError('Disk must contain a supported writable filesystem')
    # Never mount any partition backed by the same physical disk as GODSEYE data.
    data_source=cmd('/usr/bin/findmnt','-n','-o','SOURCE','-T','/var/lib/godseye').split('[',1)[0]
    if not data_source.startswith('/dev/'):raise ValueError('Cannot establish the GODSEYE data disk safely')
    def physical(source):
        lines=cmd('/usr/bin/lsblk','-snrp','-o','NAME,TYPE',source).splitlines()
        return {parts[0] for line in lines if len(parts:=line.split())==2 and parts[1]=='disk'}
    data_disks=physical(data_source);selected_disks=physical(device)
    if not data_disks or not selected_disks or data_disks & selected_disks:
        raise ValueError('Choose a separate physical disk from the GODSEYE data disk')
    os.makedirs(TARGET,mode=0o755,exist_ok=True)
    targetfd=os.open(TARGET,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
    try:
        mounted=subprocess.run(['/usr/bin/findmnt','-n','-o','UUID','--mountpoint',TARGET],capture_output=True,text=True,timeout=10)
        newly_mounted=False
        if mounted.returncode==0:
            if mounted.stdout.strip()!=uuid:raise ValueError('Another disk is mounted at the backup destination')
        else:
            if os.fstat(targetfd).st_uid!=0:raise ValueError('Backup mount directory must be root-owned')
            existing=subprocess.run(['/usr/bin/findmnt','-n','--source',device],capture_output=True,text=True,timeout=10)
            if existing.returncode==0:raise ValueError('This disk is already mounted elsewhere')
            options='nodev,nosuid,noexec'
            account=pwd.getpwnam('godseye')
            if fs in ('vfat','exfat','ntfs','ntfs3'):options+=f',uid={account.pw_uid},gid={account.pw_gid},umask=077'
            cmd('/usr/bin/mount','-o',options,device,TARGET);newly_mounted=True
        try:
            account=pwd.getpwnam('godseye');rootfd=os.open(TARGET,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
            try:
                created=False
                try:os.mkdir(SUBDIR,0o700,dir_fd=rootfd);created=True
                except FileExistsError:pass
                fd=os.open(SUBDIR,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=rootfd)
                try:
                    if created:os.fchown(fd,account.pw_uid,account.pw_gid)
                    elif os.fstat(fd).st_uid!=account.pw_uid:raise ValueError('Existing backup directory is not owned by GODSEYE')
                finally:os.close(fd)
            finally:os.close(rootfd)
        except Exception:
            if newly_mounted:subprocess.run(['/usr/bin/umount',TARGET],timeout=15,check=False,capture_output=True)
            raise
    finally:os.close(targetfd)
    print(TARGET+'/'+SUBDIR)

if __name__=='__main__':
    try:
        if len(sys.argv)!=2:raise ValueError('Provide exactly one disk UUID')
        lockfd=os.open('/run/lock/godseye-backup-mount.lock',os.O_CREAT|os.O_RDWR|os.O_NOFOLLOW,0o600)
        try:
            if os.fstat(lockfd).st_uid!=0:raise ValueError('Unsafe backup mount lock')
            fcntl.flock(lockfd,fcntl.LOCK_EX)
            main(sys.argv[1])
        finally:os.close(lockfd)
    except (OSError,ValueError,subprocess.SubprocessError,KeyError) as exc:
        print('Cannot mount backup disk: '+str(exc),file=sys.stderr);sys.exit(1)
